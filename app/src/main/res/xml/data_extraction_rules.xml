<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The encrypted webhook token must not leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="webhook_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="webhook_secure.xml" />
    </device-transfer>
</data-extraction-rules>
